# Copy to .env and export what you need (the CLI reads the environment; it does not load this file):
#   set -a; source .env; set +a
# The test suite and the demo ignore these Ethereum settings and stay on local chains.
# Everything has a working default for local development: nothing here is required to run the demo.

# -- Kafka -------------------------------------------------------------------------------------
# VIGIL_BUS=kafka://127.0.0.1:9092          # or memory:// for a single process

# -- Ethereum ----------------------------------------------------------------------------------
# VIGIL_ETH_RPC=http://127.0.0.1:8545       # local anvil (scripts/anvil_local.sh start)
# To anchor on a public network instead, point this at an RPC endpoint from a provider listed on
# ApiVault (Infura, Alchemy), and supply a funded key. Never commit a real key.
# VIGIL_ETH_RPC=https://sepolia.infura.io/v3/<your-api-key>
# VIGIL_ETH_RPC=https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
# VIGIL_ETH_PRIVATE_KEY=0x...               # a wallet made for this (cast wallet new), funded from a faucet
# VIGIL_REGISTRY=0x...                      # the registry to file in and to verify against, if not the one
#                                           # last deployed from here. On a public network, set it: a
#                                           # verification is only as good as the address it trusts, and
#                                           # that must never be taken from the report being verified.
# ETHERSCAN_API_KEY=...                     # for an explorer's second opinion on a public network

# -- Locations ---------------------------------------------------------------------------------
# VIGIL_RTG_HOME=./pyready_trader_go-2      # the Ready Trader Go distribution
# VIGIL_ARTIFACTS=./artifacts               # reports, runs, the regulatory register
# VIGIL_MODEL=./models/alpha_adaboost.json  # the alpha model the strategies load
